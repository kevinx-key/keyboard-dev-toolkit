 "terms": [
  {
   "en": "GB (Group Buy)",
   "abbr": "GB",
   "full": "Group Buy",
   "cn": "团购/开团",
   "category": "行业机制",
   "definition": "社区自发组织的预售模式：团长发布设计→IC收集意向→达MOQ后向工厂下单→生产→全球发货，全程常需6-18个月。",
   "significance": "客制化键盘最核心的商业模式，决定了整个圈子的交易节奏与风险结构。"
  },
  {
   "en": "IC (Interest Check)",
   "abbr": "IC",
   "full": "Interest Check",
   "cn": "意向调查",
   "category": "行业机制",
   "definition": "GB前的调研阶段，团长公布设计概念与渲染图，收集社区反馈、投票与预登记，用于判断需求与定价。",
   "significance": "产品能否立项的风向标；IC热度直接决定后续GB是否开得起来。"
  },
  {
   "en": "MOQ (Minimum Order Quantity)",
   "abbr": "MOQ",
   "full": "Minimum Order Quantity",
   "cn": "最小起订量",
   "category": "行业机制",
   "definition": "工厂/厂家要求的最低订单数量，未达标则可能流产、涨价或延期。",
   "significance": "GB能否成团的红线；很多好设计因达不到MOQ而夭折。"
  },
  {
   "en": "Vendor",
   "abbr": "Vendor",
   "full": "",
   "cn": "代理商/经销",
   "category": "行业机制",
   "definition": "经团长授权、负责特定地区(如EU/NA/SEA)收款与发货的合作商家。",
   "significance": "降低跨境物流与关税门槛，是GB全球化交付的关键角色。"
  },
  {
