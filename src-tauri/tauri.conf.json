{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Keyboard Dev Toolkit",
  "version": "1.0.28",
  "identifier": "com.kstar.pcb-tool",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Keyboard Dev Toolkit",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; script-src 'self'; font-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRTk0Rjc3NkNGQ0RDRUQKUldUdDNQeHNkMC9wYzVnQ2RPQXJxbUx6Tk1pVkFMNFc5VEorc0dVNkg2L2RvL2JGMndvRVRYUGwK",
      "endpoints": [
        "https://github.com/709208969/keyboard-dev-toolkit/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
